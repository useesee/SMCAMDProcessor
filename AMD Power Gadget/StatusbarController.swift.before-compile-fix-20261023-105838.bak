//
//  StatusbarController.swift
//  AMD Power Gadget
//
//  Menu-bar layout modification:
//  - CPU label is vertical like TEM/PWR.
//  - Layout and spacing are controlled by StatusbarLayout constants.
//  - Temperature turns red above 70 C; power turns red above 10 W.
//

import Cocoa
import QuartzCore
import Darwin

/// Tweak these constants to adjust menu-bar positions and spacing.
private enum StatusbarLayout {
    // All menu-bar geometry is in AppKit points. Keep this table as the single
    // place to tune positions and dimensions.
    static let itemWidth: CGFloat = 210

    static let fanX: CGFloat = 0
    static let fanSize: CGFloat = 16
    static let cpuValueX: CGFloat = fanX + fanSize + 6

    static let thermometerX: CGFloat = 58
    static let thermometerWidth: CGFloat = 12
    static let thermometerHeight: CGFloat = 18
    static let temperatureValueX: CGFloat = 72

    static let batteryX: CGFloat = 99
    static let batteryWidth: CGFloat = 12
    static let batteryHeight: CGFloat = 18
    static let powerValueX: CGFloat = 113

    static let powerToMemoryGap: CGFloat = 8
    static let memoryPieSize: CGFloat = 18
    static let memoryValueGap: CGFloat = 6
    static let memoryValueWidth: CGFloat = 35
    static let powerValueFont = NSFont.systemFont(ofSize: 12, weight: .regular)

    static func memoryPieX(for power: Float) -> CGFloat {
        let text = NSAttributedString(string: "\(Int(round(power)))ᵂ", attributes: [.font: powerValueFont])
        return powerValueX + text.size().width + powerToMemoryGap
    }

    static func memoryValueX(for power: Float) -> CGFloat {
        return memoryPieX(for: power) + memoryPieSize + memoryValueGap
    }

    static let frequencyTopY: CGFloat = 9
    static let frequencyBottomY: CGFloat = -1
    static let valueOriginY: CGFloat = 2.5
    static let compactValueFontSize: CGFloat = 10

    static let frequencyThreshold: Float = 3.2
    static let temperatureThreshold: Float = 68
    static let powerThreshold: Float = 10

    static let highlightColor = NSColor(
        calibratedRed: 1,
        green: 0.6,
        blue: 0,
        alpha: 1
    )
}

private enum MemoryPalette {
    static let available = NSColor(calibratedRed: 0.20, green: 0.78, blue: 0.45, alpha: 1)
    static let app = NSColor(calibratedRed: 1.00, green: 0.60, blue: 0.00, alpha: 1)
    static let wired = NSColor(calibratedRed: 0.28, green: 0.64, blue: 1.00, alpha: 1)
    static let compressed = NSColor(calibratedRed: 0.69, green: 0.51, blue: 0.98, alpha: 1)
}

private struct MemorySnapshot {
    let totalBytes: UInt64
    let availableBytes: UInt64
    let appBytes: UInt64
    let wiredBytes: UInt64
    let compressedBytes: UInt64

    static let zero = MemorySnapshot(
        totalBytes: 0, availableBytes: 0, appBytes: 0, wiredBytes: 0, compressedBytes: 0
    )

    var usedBytes: UInt64 {
        return totalBytes > availableBytes ? totalBytes - availableBytes : 0
    }

    static func gibibytes(_ bytes: UInt64) -> String {
        return String(format: "%.1f", Double(bytes) / 1_073_741_824.0)
    }

    // The four displayed parts partition physical RAM. App memory follows the
    // requested approximation: internal_page_count minus purgeable_count.
    // Available is the residual after App, wired, and compressed pages.
    static func sample() -> MemorySnapshot? {
        var statistics = vm_statistics64()
        // Request the rev-1 structure size. This keeps the call compatible with
        // older macOS kernels while including compressor/internal page counters.
        var count = mach_msg_type_number_t(HOST_VM_INFO64_REV1_COUNT)
        let requestedCount = count
        let hostPort = mach_host_self()
        defer {
            mach_port_deallocate(mach_task_self_, hostPort)
        }

        let result: kern_return_t = withUnsafeMutablePointer(to: &statistics) { pointer in
            pointer.withMemoryRebound(to: integer_t.self, capacity: Int(requestedCount)) { info in
                host_statistics64(hostPort, HOST_VM_INFO64, info, &count)
            }
        }
        guard result == KERN_SUCCESS else {
            NSLog("Menu-bar memory sampling failed: %@", String(cString: mach_error_string(result)))
            return nil
        }

        let physicalBytes = ProcessInfo.processInfo.physicalMemory
        let pageSize = UInt64(vm_page_size)
        guard physicalBytes > 0, pageSize > 0 else { return nil }
        let totalPages = physicalBytes / pageSize

        let internalPages = UInt64(statistics.internal_page_count)
        let purgeablePages = UInt64(statistics.purgeable_count)
        let rawAppPages = internalPages > purgeablePages ? internalPages - purgeablePages : 0
        let rawWiredPages = UInt64(statistics.wire_count)
        let rawCompressedPages = UInt64(statistics.compressor_page_count)

        let appPages = min(rawAppPages, totalPages)
        let wiredPages = min(rawWiredPages, totalPages - appPages)
        let compressedPages = min(rawCompressedPages, totalPages - appPages - wiredPages)
        let availablePages = totalPages - appPages - wiredPages - compressedPages

        return MemorySnapshot(
            totalBytes: totalPages * pageSize,
            availableBytes: availablePages * pageSize,
            appBytes: appPages * pageSize,
            wiredBytes: wiredPages * pageSize,
            compressedBytes: compressedPages * pageSize
        )
    }
}

private final class FanIndicatorView: NSView {
    private let rotatingLayer = CALayer()
    private var sourceFanImage: CGImage?
    private var whiteFanImage: CGImage?
    private var hotFanImage: CGImage?
    private var isHot = false
    private var lastTemperature: Float?
    private var currentRotationSpeed: Float = 1

    override init(frame frameRect: NSRect) {
        super.init(frame: frameRect)
        initializeFan()
    }

    required init?(coder: NSCoder) {
        super.init(coder: coder)
        initializeFan()
    }

    private func initializeFan() {
        wantsLayer = true
        guard let rootLayer = layer else { return }
        rootLayer.masksToBounds = false

        sourceFanImage = NSImage(named: NSImage.Name("MenuBarFan"))?.cgImage(
            forProposedRect: nil, context: nil, hints: nil
        )
        whiteFanImage = makeTintedImage(color: .white)
        hotFanImage = makeTintedImage(color: StatusbarLayout.highlightColor)

        rotatingLayer.bounds = CGRect(x: 0, y: 0,
                                       width: StatusbarLayout.fanSize,
                                       height: StatusbarLayout.fanSize)
        rotatingLayer.anchorPoint = CGPoint(x: 0.5, y: 0.5)
        rotatingLayer.position = CGPoint(x: bounds.midX, y: bounds.midY)
        rotatingLayer.contentsGravity = .resizeAspect
        rotatingLayer.contentsScale = NSScreen.main?.backingScaleFactor ?? 2.0
        rotatingLayer.magnificationFilter = .linear
        rotatingLayer.minificationFilter = .linear
        rotatingLayer.contents = whiteFanImage
        rootLayer.addSublayer(rotatingLayer)

        // Exactly one perpetual rotation animation is installed at initialization.
        // Temperature changes adjust the layer's time mapping rather than replacing it.
        let rotation = CABasicAnimation(keyPath: "transform.rotation.z")
        rotation.fromValue = 0.0
        rotation.toValue = -2.0 * Double.pi // Negative Z is clockwise in this unflipped AppKit view.
        rotation.duration = 10.0
        rotation.repeatCount = Float.infinity
        rotation.timingFunction = CAMediaTimingFunction(name: kCAMediaTimingFunctionLinear)
        rotation.isRemovedOnCompletion = false
        rotatingLayer.add(rotation, forKey: "menuBarFanRotation")
    }

    override func layout() {
        super.layout()
        rotatingLayer.position = CGPoint(x: bounds.midX, y: bounds.midY)
        rotatingLayer.bounds = CGRect(x: 0, y: 0, width: bounds.width, height: bounds.height)
    }

    private func makeTintedImage(color: NSColor) -> CGImage? {
        guard let source = sourceFanImage else { return nil }
        let width = source.width
        let height = source.height
        let rect = CGRect(x: 0, y: 0, width: width, height: height)
        guard let context = CGContext(
            data: nil,
            width: width,
            height: height,
            bitsPerComponent: 8,
            bytesPerRow: width * 4,
            space: CGColorSpaceCreateDeviceRGB(),
            bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
        ) else { return nil }

        context.clear(rect)
        context.draw(source, in: rect)
        context.setBlendMode(.sourceIn)
        context.setFillColor(color.cgColor)
        context.fill(rect)
        return context.makeImage()
    }

    private func rotationSpeed(for temperature: Float) -> Float {
        let clamped = min(85.0, max(45.0, temperature))
        let x = Double(clamped - 45.0) / 40.0
        // Cubic response: gentle at lower temperatures, steep above ~65 C.
        // Base period is 10 seconds at 45 C; 33.333x speed yields 0.3 s at 85 C.
        return Float(1.0 + ((10.0 / 0.3) - 1.0) * pow(x, 3.0))
    }

    private func setRotationSpeedPreservingPhase(_ newSpeed: Float) {
        guard newSpeed > 0, abs(newSpeed - currentRotationSpeed) > 0.0001 else { return }
        let now = CACurrentMediaTime()
        // `beginTime` is expressed in the superlayer's local time coordinate.
        let parentTime = rotatingLayer.superlayer?.convertTime(now, from: nil) ?? now
        // Capture the currently running animation's local time before changing speed.
        let localTime = rotatingLayer.convertTime(now, from: nil)
        rotatingLayer.speed = newSpeed
        // Rebase beginTime so the new time mapping yields the same localTime at `now`.
        rotatingLayer.beginTime = parentTime - localTime / CFTimeInterval(newSpeed)
        currentRotationSpeed = newSpeed
    }

    func updateTemperature(_ temperature: Float) {
        guard temperature.isFinite else { return }
        let shouldBeHot = temperature > StatusbarLayout.temperatureThreshold
        // Recolor only at initialization or when crossing the 68 C threshold.
        if shouldBeHot != isHot {
            rotatingLayer.contents = shouldBeHot ? hotFanImage : whiteFanImage
            isHot = shouldBeHot
        }
        if lastTemperature == nil || lastTemperature! != temperature {
            setRotationSpeedPreservingPhase(rotationSpeed(for: temperature))
            lastTemperature = temperature
        }
    }
}

private final class ThermometerIndicatorView: NSView {
    var temperature: Float = 0

    override func draw(_ dirtyRect: NSRect) {
        let color = temperature > StatusbarLayout.temperatureThreshold
            ? StatusbarLayout.highlightColor : NSColor.white
        color.setStroke()
        color.setFill()

        let stem = NSBezierPath(roundedRect: NSRect(x: 4.0, y: 5.8, width: 4.2, height: 10.4),
                                xRadius: 2.0, yRadius: 2.0)
        stem.lineWidth = 1.1
        stem.stroke()
        let bulb = NSBezierPath(ovalIn: NSRect(x: 2.0, y: 1.6, width: 8.2, height: 8.2))
        bulb.lineWidth = 1.1
        bulb.stroke()

        let fraction = min(1.0, max(0.0, (temperature - 35.0) / 60.0))
        let mercuryHeight = CGFloat(fraction) * 8.1
        NSBezierPath(rect: NSRect(x: 5.3, y: 5.8, width: 1.6, height: mercuryHeight)).fill()
        NSBezierPath(ovalIn: NSRect(x: 4.0, y: 3.5, width: 4.2, height: 4.2)).fill()

        // Four small scale marks span the 35–95 C range.
        for index in 0..<4 {
            let y = CGFloat(7 + index * 2)
            NSBezierPath(rect: NSRect(x: 8.8, y: y, width: 2.0, height: 0.7)).fill()
        }
    }
}

private final class BatteryIndicatorView: NSView {
    var power: Float = 0

    override func draw(_ dirtyRect: NSRect) {
        let color = power > StatusbarLayout.powerThreshold
            ? StatusbarLayout.highlightColor : NSColor.white
        color.setStroke()
        color.setFill()

        let cap = NSBezierPath(roundedRect: NSRect(x: 4.5, y: 15.8, width: 3.2, height: 1.5),
                               xRadius: 0.5, yRadius: 0.5)
        cap.fill()
        let body = NSBezierPath(roundedRect: NSRect(x: 2.6, y: 2.0, width: 7.0, height: 13.6),
                                xRadius: 1.5, yRadius: 1.5)
        body.lineWidth = 1.1
        body.stroke()

        // Battery fill is scaled to the requested 1–25 W range.
        let fraction = min(1.0, max(0.0, (power - 1.0) / 24.0))
        let fillHeight = CGFloat(fraction) * 10.0
        NSBezierPath(rect: NSRect(x: 4.0, y: 3.6, width: 4.2, height: fillHeight)).fill()
    }
}

private final class MemoryTooltipView: NSView {
    var snapshot: MemorySnapshot = .zero

    override func draw(_ dirtyRect: NSRect) {
        let background = NSBezierPath(roundedRect: bounds, xRadius: 7, yRadius: 7)
        NSColor(calibratedWhite: 0.12, alpha: 0.97).setFill()
        background.fill()

        let rows: [(String, String, NSColor)] = [
            ("可用内存", MemorySnapshot.gibibytes(snapshot.availableBytes) + "G", MemoryPalette.available),
            ("App 内存", MemorySnapshot.gibibytes(snapshot.appBytes) + "G", MemoryPalette.app),
            ("联动内存", MemorySnapshot.gibibytes(snapshot.wiredBytes) + "G", MemoryPalette.wired),
            ("压缩内存", MemorySnapshot.gibibytes(snapshot.compressedBytes) + "G", MemoryPalette.compressed)
        ]
        let font = NSFont.systemFont(ofSize: 12, weight: .regular)
        let attributes: [NSAttributedString.Key: Any] = [
            .font: font,
            .foregroundColor: NSColor.white
        ]

        for (index, row) in rows.enumerated() {
            let y = bounds.height - 16.0 - CGFloat(index) * 15.0
            row.2.setFill()
            NSBezierPath(ovalIn: NSRect(x: 8, y: y + 4.0, width: 6, height: 6)).fill()
            (row.0 as NSString).draw(at: NSPoint(x: 20, y: y), withAttributes: attributes)
            let value = NSAttributedString(string: row.1, attributes: attributes)
            value.draw(at: NSPoint(x: bounds.width - 6.0 - value.size().width, y: y))
        }
    }
}

private final class MemoryTooltipController {
    static let shared = MemoryTooltipController()
    private var tooltipWindow: NSWindow?
    private var tooltipView: MemoryTooltipView?
    private let tooltipSize = NSSize(width: 128, height: 76)

    private init() {}

    func show(snapshot: MemorySnapshot, from source: NSView) {
        guard let sourceWindow = source.window else { return }
        if tooltipWindow == nil {
            let content = MemoryTooltipView(frame: NSRect(origin: .zero, size: tooltipSize))
            let panel = NSWindow(
                contentRect: NSRect(origin: .zero, size: tooltipSize),
                styleMask: .borderless,
                backing: .buffered,
                defer: false
            )
            panel.isOpaque = false
            panel.backgroundColor = NSColor.clear
            panel.hasShadow = true
            panel.ignoresMouseEvents = true
            panel.level = .popUpMenu
            panel.contentView = content
            tooltipView = content
            tooltipWindow = panel
        }
        tooltipView?.snapshot = snapshot
        tooltipView?.needsDisplay = true

        let sourceRect = source.convert(source.bounds, to: nil)
        let screenRect = sourceWindow.convertToScreen(sourceRect)
        let visible = sourceWindow.screen?.visibleFrame
            ?? NSScreen.screens.first?.visibleFrame
            ?? NSRect(x: 0, y: 0, width: 1280, height: 800)
        let x = min(max(screenRect.midX - tooltipSize.width / 2, visible.minX + 4),
                    visible.maxX - tooltipSize.width - 4)
        let y = max(visible.minY + 4, screenRect.minY - tooltipSize.height - 5)
        tooltipWindow?.setFrameOrigin(NSPoint(x: x, y: y))
        tooltipWindow?.orderFrontRegardless()
    }

    func refresh(snapshot: MemorySnapshot) {
        guard tooltipWindow?.isVisible == true else { return }
        tooltipView?.snapshot = snapshot
        tooltipView?.needsDisplay = true
    }

    func hide() {
        tooltipWindow?.orderOut(nil)
    }
}

private final class MemoryPieView: NSView {
    private(set) var snapshot: MemorySnapshot = .zero
    private var trackingArea: NSTrackingArea?

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        if let trackingArea = trackingArea {
            removeTrackingArea(trackingArea)
        }
        let newArea = NSTrackingArea(
            rect: bounds,
            options: [.mouseEnteredAndExited, .activeAlways, .inVisibleRect],
            owner: self,
            userInfo: nil
        )
        addTrackingArea(newArea)
        trackingArea = newArea
    }

    private var isHovering = false

    override func mouseEntered(with event: NSEvent) {
        isHovering = true
        MemoryTooltipController.shared.show(snapshot: snapshot, from: self)
    }

    override func mouseExited(with event: NSEvent) {
        isHovering = false
        MemoryTooltipController.shared.hide()
    }

    func updateSnapshot(_ newSnapshot: MemorySnapshot) {
        guard newSnapshot.totalBytes != snapshot.totalBytes
            || newSnapshot.availableBytes != snapshot.availableBytes
            || newSnapshot.appBytes != snapshot.appBytes
            || newSnapshot.wiredBytes != snapshot.wiredBytes
            || newSnapshot.compressedBytes != snapshot.compressedBytes else { return }
        snapshot = newSnapshot
        needsDisplay = true
        if isHovering {
            MemoryTooltipController.shared.refresh(snapshot: newSnapshot)
        }
    }

    override func draw(_ dirtyRect: NSRect) {
        guard snapshot.totalBytes > 0 else { return }
        let parts: [(UInt64, NSColor)] = [
            (snapshot.availableBytes, MemoryPalette.available),
            (snapshot.appBytes, MemoryPalette.app),
            (snapshot.wiredBytes, MemoryPalette.wired),
            (snapshot.compressedBytes, MemoryPalette.compressed)
        ]
        let center = NSPoint(x: bounds.midX, y: bounds.midY)
        let radius = min(bounds.width, bounds.height) / 2.0
        var startAngle: CGFloat = 90.0
        for (bytes, color) in parts where bytes > 0 {
            let sweep = CGFloat(Double(bytes) / Double(snapshot.totalBytes)) * 360.0
            let endAngle = startAngle - sweep
            let path = NSBezierPath()
            path.move(to: center)
            path.appendArc(withCenter: center, radius: radius,
                           startAngle: startAngle, endAngle: endAngle, clockwise: true)
            path.close()
            color.setFill()
            path.fill() // Deliberately no black outline.
            startAngle = endAngle
        }
    }
}

fileprivate class StatusbarView: NSView {
    var meanFreq: Float = 0
    var maxFreq: Float = 0

    private var compactValue: [NSAttributedString.Key: Any] = [:]
    private let fanView = FanIndicatorView(frame: .zero)
    private let thermometerView = ThermometerIndicatorView(frame: .zero)
    private let batteryView = BatteryIndicatorView(frame: .zero)
    private let memoryPieView = MemoryPieView(frame: .zero)
    private var lastTemperature: Float = 0
    private var lastPower: Float = 0

    func setup() {
        compactValue = [
            .font: NSFont.systemFont(ofSize: StatusbarLayout.compactValueFontSize, weight: .semibold),
            .foregroundColor: NSColor.white
        ]
        addSubview(fanView)
        addSubview(thermometerView)
        addSubview(batteryView)
        addSubview(memoryPieView)
        autoresizingMask = [.width, .height]
        needsLayout = true
    }

    override func layout() {
        super.layout()
        fanView.frame = NSRect(x: StatusbarLayout.fanX,
                               y: (bounds.height - StatusbarLayout.fanSize) / 2.0,
                               width: StatusbarLayout.fanSize,
                               height: StatusbarLayout.fanSize)
        thermometerView.frame = NSRect(x: StatusbarLayout.thermometerX,
                                       y: (bounds.height - StatusbarLayout.thermometerHeight) / 2.0,
                                       width: StatusbarLayout.thermometerWidth,
                                       height: StatusbarLayout.thermometerHeight)
        batteryView.frame = NSRect(x: StatusbarLayout.batteryX,
                                   y: (bounds.height - StatusbarLayout.batteryHeight) / 2.0,
                                   width: StatusbarLayout.batteryWidth,
                                   height: StatusbarLayout.batteryHeight)
        memoryPieView.frame = NSRect(x: StatusbarLayout.memoryPieX(for: lastPower),
                                     y: (bounds.height - StatusbarLayout.memoryPieSize) / 2.0,
                                     width: StatusbarLayout.memoryPieSize,
                                     height: StatusbarLayout.memoryPieSize)
    }

    func updateIndicators(temperature: Float, power: Float, memory: MemorySnapshot?) {
        if temperature != lastTemperature {
            thermometerView.temperature = temperature
            thermometerView.needsDisplay = true
            lastTemperature = temperature
        }
        if power != lastPower {
            batteryView.power = power
            batteryView.needsDisplay = true
            lastPower = power
            needsLayout = true
        }
        fanView.updateTemperature(temperature)
        if let memory = memory {
            memoryPieView.updateSnapshot(memory)
        }
    }

    override func draw(_ dirtyRect: NSRect) {
        let averageGHz = meanFreq * 0.001
        let maximumGHz = maxFreq * 0.001
        let upper = NSAttributedString(
            string: String(format: "%.1fᴳ", maximumGHz),
            attributes: [.font: NSFont.systemFont(ofSize: StatusbarLayout.compactValueFontSize, weight: .semibold),
                         .foregroundColor: maximumGHz > StatusbarLayout.frequencyThreshold
                            ? StatusbarLayout.highlightColor : NSColor.white]
        )
        let lower = NSAttributedString(
            string: String(format: "%.1fᴳ", averageGHz),
            attributes: [.font: NSFont.systemFont(ofSize: StatusbarLayout.compactValueFontSize, weight: .semibold),
                         .foregroundColor: averageGHz > StatusbarLayout.frequencyThreshold
                            ? StatusbarLayout.highlightColor : NSColor.white]
        )
        upper.draw(at: NSPoint(x: StatusbarLayout.cpuValueX, y: StatusbarLayout.frequencyTopY))
        lower.draw(at: NSPoint(x: StatusbarLayout.cpuValueX, y: StatusbarLayout.frequencyBottomY))

        let temperature = NSAttributedString(
            string: "\(Int(round(lastTemperature)))º",
            attributes: [.font: NSFont.systemFont(ofSize: 12, weight: .regular),
                         .foregroundColor: lastTemperature > StatusbarLayout.temperatureThreshold
                            ? StatusbarLayout.highlightColor : NSColor.white]
        )
        temperature.draw(at: NSPoint(x: StatusbarLayout.temperatureValueX, y: StatusbarLayout.valueOriginY))

        let power = NSAttributedString(
            string: "\(Int(round(lastPower)))ᵂ",
            attributes: [.font: StatusbarLayout.powerValueFont,
                         .foregroundColor: lastPower > StatusbarLayout.powerThreshold
                            ? StatusbarLayout.highlightColor : NSColor.white]
        )
        power.draw(at: NSPoint(x: StatusbarLayout.powerValueX, y: StatusbarLayout.valueOriginY))

        let memory = memoryPieView.snapshot
        let availableText = NSAttributedString(
            string: MemorySnapshot.gibibytes(memory.availableBytes) + "G",
            attributes: compactValue
        )
        var usedAttributes = compactValue
        usedAttributes[.foregroundColor] = NSColor.white
        let usedText = NSAttributedString(
            string: MemorySnapshot.gibibytes(memory.usedBytes) + "G",
            attributes: usedAttributes
        )
        availableText.draw(at: NSPoint(
            x: StatusbarLayout.memoryValueX(for: lastPower) + StatusbarLayout.memoryValueWidth - availableText.size().width,
            y: StatusbarLayout.frequencyTopY
        ))
        usedText.draw(at: NSPoint(
            x: StatusbarLayout.memoryValueX(for: lastPower) + StatusbarLayout.memoryValueWidth - usedText.size().width,
            y: StatusbarLayout.frequencyBottomY
        ))
    }
}


class StatusbarController {

    var statusItem: NSStatusItem!
    fileprivate var view: StatusbarView!

    var updateTimer: Timer?
    var menu: NSMenu?

    init() {
        statusItem = NSStatusBar.system.statusItem(withLength: NSStatusItem.variableLength)
        statusItem.isVisible = true

        view = StatusbarView()
        view.setup()

        statusItem.button?.wantsLayer = true
        statusItem.button?.addSubview(view)

        statusItem.button?.target = self
        statusItem.button?.action = #selector(itemClicked)
        statusItem.button?.sendAction(on: [.leftMouseUp, .rightMouseUp])

        statusItem.length = StatusbarLayout.itemWidth
        view.frame = statusItem.button!.bounds

        addMenuItems()

        updateTimer = Timer.scheduledTimer(withTimeInterval: 1, repeats: true, block: { [weak self] _ in
            self?.update()
        })
        update() // Prime values immediately; the repeating timer remains the only sampler.
    }

    func dismiss() {
        updateTimer?.invalidate()
        updateTimer = nil
        MemoryTooltipController.shared.hide()
        if let item = statusItem {
            NSStatusBar.system.removeStatusItem(item)
        }
        statusItem = nil
        view = nil
    }

    deinit {
        updateTimer?.invalidate()
        MemoryTooltipController.shared.hide()
    }

    func update() {
        let numberOfCores = ProcessorModel.shared.getNumOfCore()
        guard numberOfCores > 0 else { return }
        // CPU, temperature and power are sampled once through the existing model API.
        let outputStr: [Float] = ProcessorModel.shared.getMetric(forced: false)
        guard outputStr.count >= numberOfCores + 3 else { return }

        let power = outputStr[0]
        let temperature = outputStr[1]
        let frequencies = Array(outputStr[3..<(numberOfCores + 3)])
        guard !frequencies.isEmpty else { return }

        let meanFre = Float(frequencies.reduce(0, +) / Float(frequencies.count))
        guard let maxFre = frequencies.max() else { return }

        view?.meanFreq = meanFre
        view?.maxFreq = maxFre
        view?.updateIndicators(temperature: temperature,
                               power: power,
                               memory: MemorySnapshot.sample())
        view?.setNeedsDisplay(view?.bounds ?? .zero)
    }

    @objc func itemClicked() {
        switch NSApp.currentEvent?.type {
        case .leftMouseUp:
            NSApp.activate(ignoringOtherApps: true)
            ViewController.launch(forceFocus: true)

        case .rightMouseUp:
            guard let m = menu else { return }
            statusItem.popUpMenu(m)

        default:
            break
        }
    }

    @objc func gadget() {
        ViewController.launch(forceFocus: true)
    }

    @objc func tool() {
        PowerToolViewController.launch(forceFocus: true)
    }

    @objc func fans() {
        SystemMonitorViewController.launch(forceFocus: true)
    }

    @objc func exitApp() {
        exit(0)
    }

    private func addMenuItems() {
        menu = NSMenu()
        guard let m = menu else { return }

        var item = NSMenuItem(title: "AMD Power Gadget", action: #selector(gadget), keyEquivalent: "")
        item.target = self
        m.addItem(item)

        item = NSMenuItem(title: "AMD Power Tool", action: #selector(tool), keyEquivalent: "")
        item.target = self
        m.addItem(item)

        item = NSMenuItem(title: "SMC Fans", action: #selector(fans), keyEquivalent: "")
        item.target = self
        m.addItem(item)

        m.addItem(NSMenuItem.separator())

        item = NSMenuItem(title: "Exit", action: #selector(exitApp), keyEquivalent: "")
        item.target = self
        m.addItem(item)
    }
}
